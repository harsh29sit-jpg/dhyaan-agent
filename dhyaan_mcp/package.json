{
  "name": "dhyaan-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.20.0 <23" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:mcp": "vitest run tests/mcp.test.ts",
    "test:integration": "vitest run tests/integration",
    "migrate": "node dist/src/db/migrate.js",
    "catalog": "node dist/scripts/catalog.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "express": "5.2.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.1",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
